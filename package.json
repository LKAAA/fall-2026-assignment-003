{
  "name": "agile-issue-tracker-api",
  "version": "1.0.0",
  "description": "Agile Issue Tracker API Starter - RESTful Web Services & Relational Databases",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "migrate:up": "tsx src/db/migrator.ts up",
    "migrate:down": "tsx src/db/migrator.ts down",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "express",
    "typescript",
    "postgres",
    "kysely",
    "vitest",
    "supertest"
  ],
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kysely": "0.27.4",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.1"
  }
}